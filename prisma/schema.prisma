  desiredTiming           WardLeadDesiredTiming?
  consentPurpose          String
  consentVersion          String
  consentText             String
  consentTextSha256       String
  consentDataClasses      String[]
  consentGrantedAt        DateTime
  consentExpiresAt        DateTime
