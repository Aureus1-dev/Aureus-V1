}

// ===========================================================================
// User
// ===========================================================================

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String // Uniqueness enforced by partial index (migration 004)
  emailVerified Boolean    @default(false)
  passwordHash  String? // Nullable: pre-existing/imported users have no credential yet
  roles         UserRole[] @default([MEMBER])
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  // Guest Steward mode (Production Execution Order — unauthenticated first
  // experience). A guest is an ordinary User row — real id, real JWTs,
  // every existing self-only endpoint works unchanged — created with a
  // synthetic, unique, never-shown `email` (already possible without a
  // schema change: `email` only needed to stay unique, and `passwordHash`
  // was already nullable for exactly this "no credential yet" case) plus
  // `isGuest: true` so the app can tell a guest session from a real one.
  // Claiming an account (AuthService.claimGuestAccount) flips this to
  // false and stamps `guestClaimedAt` in the same UPDATE that sets the
  // real email/passwordHash — same row, same id, so every existing
  // relation (conversations, needs, goals, ...) is preserved with zero
  // migration of its own.
  isGuest        Boolean   @default(false)
  guestClaimedAt DateTime?

  // Privacy lifecycle: set at guest creation, touched on every
  // authenticated request a guest makes (JwtStrategy — real activity,
  // not silent token refresh). GuestLifecycleService's scheduled purge
  // reads this to find abandoned guests; meaningless once isGuest is
  // false (a claimed account is never purged), left in place rather
  // than cleared so the claim moment's own history stays intact.
  guestLastActiveAt DateTime?

  // TOTP multi-factor authentication (PD-001 Production Foundation). mfaSecret
  // holds the base32 TOTP secret once enrollment begins — set before
  // mfaEnabled flips true, so an in-progress (unconfirmed) enrollment never
  // enables login enforcement on its own. mfaRecoveryCodes are bcrypt hashes,
  // never plaintext; each is single-use and removed from the array once
  // redeemed.
  mfaEnabled       Boolean  @default(false)
  mfaSecret        String?
  mfaRecoveryCodes String[] @default([])

  // Brute-force protection (PR-002). Reset to 0 on any successful login;
  // incremented on each failed password check; lockedUntil is set once the
  // threshold is reached and cleared automatically once it elapses.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  profile                     Profile?
  goals                       Goal[]
  refreshTokens               RefreshToken[]
  passwordResetTokens         PasswordResetToken[]
  emailVerificationTokens     EmailVerificationToken[]
  organizationMemberships     OrganizationMember[]
  stewardCapacity             StewardCapacity?
  stewardshipAsMember         StewardshipRelationship[]  @relation("StewardshipRelationshipMember")
  stewardshipAsSteward        StewardshipRelationship[]  @relation("StewardshipRelationshipSteward")
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  announcementsAsSteward      Announcement[]             @relation("AnnouncementSteward")
  conversationMemberships     ConversationParticipant[]
  sentMessages                Message[]
  enrollments                 Enrollment[]
  certifications              Certification[]
  aiConversations             AiConversation[]
  aiRequests                  AiRequest[]
  aiRecommendations           AiRecommendation[]
  aiVoiceSessions             AiVoiceSession[]
  wardLeadEvents              WardLeadEvent[]            @relation("WardLeadEventActor")
  podMemberships              PodMembership[]
  podEventRsvps               PodEventRsvp[]
  podRequests                 PodRequest[]
  podInvitationsReceived      PodInvitation[]            @relation("PodInvitationInvitee")
  connectedAccounts           ConnectedAccount[]
  documents                   Document[]
  stewardActivityLogs         StewardActivityLog[]
  aiOperationalConfigUpdates  AiOperationalConfig[]
  aiOrchestrationRuns         AiOrchestrationRun[]
  consentRecords              ConsentRecord[]
  authorityRequestsAsSubject  AuthorityRequest[]         @relation("AuthorityRequestSubject")
  authorityGrantsAsSubject    AuthorityGrant[]           @relation("AuthorityGrantSubject")
  authorityStatesAsSubject    AuthorityCapabilityState[] @relation("AuthorityCapabilityStateSubject")
  statedNeeds                 StatedNeed[]
  resourceOffers              ResourceOffer[]
  needEscalations             NeedEscalation[]
  unresolvedNeeds             UnresolvedNeed[]
  harvestPlans                HarvestPlan[]
  guidedApplicationSessions   GuidedApplicationSession[]
  responsibilitiesAsPrincipal Responsibility[]           @relation("ResponsibilityPrincipalUser")
}

// ===========================================================================
// Authentication & Identity Access Management
// (OAS-SEC-003, PA-018 — Identity lifecycle, credential protection)
// ===========================================================================

// Refresh tokens are stored hashed (never plaintext) and rotated on use.
model RefreshToken {
  id                  String    @id @default(uuid()) @db.Uuid
  tokenHash           String    @unique
  userId              String    @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdAt           DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ===========================================================================
// Profile
// ===========================================================================

model Profile {
  id                String    @id @default(uuid()) @db.Uuid
  displayName       String?
  namePronunciation String? // member-owned cue for how Aureus should say their name; never employer-derived
  bio               String?
  avatarUrl         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // Pods matching signals (WO-030, Founder Decisions #7-#9). Every field
  // below is optional, member-owned, editable, and purpose-bound — the
  // Institution learns about a person because they chose to share, never
  // because a field was required or defaulted.
  city                 String? // coarse location — Founder Decision #8, never precise geolocation
  region               String?
  stateProvince        String?
  country              String?
  localAreaDescription String? // free text: "describe the community area you consider local to you"
  profession           String?
  seasonOfLife         SeasonOfLife? // Founder Decision #9 — a current season, never a permanent category
  availabilityNotes    String?
  preferredLanguage    String?
  faithPreference      String? // voluntary only; never defaulted, never required (§6 privacy model)

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===========================================================================
// Consent (Gate B — B3: consent and expectations captured at arrival)
// ===========================================================================

// Append-only, like CitySheetVerificationEvent: every grant is a permanent
// row, never updated or deleted, so a member's consent history can always
// be reconstructed exactly as it happened. "Current" consent is simply the
// most recent row for a given (userId, version).
model ConsentRecord {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version   String
  grantedAt DateTime @default(now())

  @@index([userId])
  @@index([userId, version])
}

// ===========================================================================
// Authority, Consent & Trust — Step 2
// Runtime permission is separate from ConsentRecord (arrival expectations).
// A request never grants authority. Only an approved request can create an
// active grant; revocation/suspension are evaluated from the database on every
// gateway decision. Secrets/raw transcripts are never fields in this ledger.
// ===========================================================================

enum AuthorityContextType {
  PERSONAL
  BUSINESS_TENANT
}

enum AuthorityCapability {
  SEE
  LISTEN
  READ
  WRITE
  SHARE
  ACT
}

enum AuthorityResourceClass {
  MICROPHONE
  SCREEN
  CONVERSATION
  CONNECTED_ACCOUNT
  CALENDAR
  EMAIL
  FILES
  BUSINESS_DATA
  OTHER
}

enum AuthorityRequestSource {
  USER
  AUREUS
  DERIVED_PATTERN
}

enum AuthorityRequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

enum AuthorityGrantStatus {
  ACTIVE
  REVOKED
}

enum AuthorityCapabilityStatus {
  ACTIVE
  SUSPENDED
}

enum AuthorityEventType {
  REQUEST_CREATED
  REQUEST_APPROVED
  REQUEST_DENIED
  GRANT_CREATED
  GRANT_REVOKED
  CAPABILITY_SUSPENDED
  CAPABILITY_RESUMED
}

enum AuthorityDecisionResult {
  PERMIT
  NEEDS_APPROVAL
  DENY
}

model AuthorityRequest {
  id                String                 @id @default(uuid()) @db.Uuid
  contextType       AuthorityContextType
  subjectUserId     String?                @db.Uuid
  subjectUser       User?                  @relation("AuthorityRequestSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  organizationId    String?                @db.Uuid
  organization      Organization?          @relation("AuthorityRequestOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  capability        AuthorityCapability
  resourceClass     AuthorityResourceClass
  resourceRef       String?
  purpose           String
  source            AuthorityRequestSource @default(USER)
  status            AuthorityRequestStatus @default(PENDING)
  policyVersion     String                 @default("step2-v1")
  requestedByUserId String?                @db.Uuid
  approvedByUserId  String?                @db.Uuid
  deniedByUserId    String?                @db.Uuid
  expiresAt         DateTime?
  decidedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  grant AuthorityGrant?

  @@index([subjectUserId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([capability, resourceClass, status])
}

model AuthorityGrant {
  id              String                 @id @default(uuid()) @db.Uuid
  requestId       String                 @unique @db.Uuid
  request         AuthorityRequest       @relation(fields: [requestId], references: [id], onDelete: Restrict)
  contextType     AuthorityContextType
  subjectUserId   String?                @db.Uuid
  subjectUser     User?                  @relation("AuthorityGrantSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  organizationId  String?                @db.Uuid
  organization    Organization?          @relation("AuthorityGrantOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  capability      AuthorityCapability
  resourceClass   AuthorityResourceClass
  resourceRef     String?
  purpose         String
  policyVersion   String
  status          AuthorityGrantStatus   @default(ACTIVE)
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokedByUserId String?                @db.Uuid
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([subjectUserId, status, capability, resourceClass])
  @@index([organizationId, status, capability, resourceClass])
  @@index([expiresAt])
}

model AuthorityCapabilityState {
  id                String                    @id @default(uuid()) @db.Uuid
  scopeKey          String
  contextType       AuthorityContextType
  subjectUserId     String?                   @db.Uuid
  subjectUser       User?                     @relation("AuthorityCapabilityStateSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  organizationId    String?                   @db.Uuid
  organization      Organization?             @relation("AuthorityCapabilityStateOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  capability        AuthorityCapability
  status            AuthorityCapabilityStatus @default(ACTIVE)
  suspendedReason   String?
  suspendedAt       DateTime?
  suspendedByUserId String?                   @db.Uuid
  resumedAt         DateTime?
  resumedByUserId   String?                   @db.Uuid
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([scopeKey, capability])
  @@index([subjectUserId, status])
  @@index([organizationId, status])
}

model AuthorityEvent {
  id             String                  @id @default(uuid()) @db.Uuid
  eventType      AuthorityEventType
  actorUserId    String?                 @db.Uuid
  requestId      String?                 @db.Uuid
  grantId        String?                 @db.Uuid
  contextType    AuthorityContextType
  subjectUserId  String?                 @db.Uuid
  organizationId String?                 @db.Uuid
  capability     AuthorityCapability?
  resourceClass  AuthorityResourceClass?
  resourceRef    String?
  reason         String?
  occurredAt     DateTime                @default(now())

  @@index([subjectUserId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([requestId])
  @@index([grantId])
}

model AuthorityDecision {
  id             String                  @id @default(uuid()) @db.Uuid
  actorUserId    String?                 @db.Uuid
  contextType    AuthorityContextType
  subjectUserId  String?                 @db.Uuid
  organizationId String?                 @db.Uuid
  capability     AuthorityCapability
  resourceClass  AuthorityResourceClass
  resourceRef    String?
  result         AuthorityDecisionResult
  reason         String
  grantId        String?                 @db.Uuid
  policyVersion  String
  createdAt      DateTime                @default(now())

  @@index([subjectUserId, createdAt])
  @@index([organizationId, createdAt])
  @@index([result, createdAt])
}

// ===========================================================================
// Responsibility Core — PA-021 / OR-001
//
// The root is intentionally thin: it joins an accepted outcome to explicit
// principal/context, bounded authority/privacy, durable status, provenance,
// and append-only evidence/events. Domain records remain authoritative for
// their own facts; Responsibility must not become a duplicate workflow engine.
// ===========================================================================

model Responsibility {
  id        String               @id @default(uuid()) @db.Uuid
  kind      ResponsibilityKind
  objective String
  status    ResponsibilityStatus @default(ACTIVE)

  contextType             ResponsibilityContextType
  principalUserId         String?                   @db.Uuid
  principalOrganizationId String?                   @db.Uuid
  principalUser           User?                     @relation("ResponsibilityPrincipalUser", fields: [principalUserId], references: [id], onDelete: Cascade)
  principalOrganization   Organization?             @relation("ResponsibilityPrincipalOrganization", fields: [principalOrganizationId], references: [id], onDelete: Cascade)

  // Provenance pointers are deliberately not foreign keys. The accepted work
  // survives ordinary conversation/domain lifecycle changes while the service
  // validates ownership/currentness at the moment the Responsibility is made.
  originConversationId String? @db.Uuid
  originOpportunityId  String? @db.Uuid

  successCriteria        Json
  authorityClass         ResponsibilityAuthorityClass
  authorityPolicyVersion String
  privacyScope           ResponsibilityPrivacyScope
  privacyPolicyVersion   String

  dueAt              DateTime?
  retentionExpiresAt DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  events                    ResponsibilityEvent[]
  guidedApplicationSessions GuidedApplicationSession[]

  @@index([contextType, principalUserId, status, updatedAt])
  @@index([principalOrganizationId, status, updatedAt])
  @@index([originConversationId])
  @@index([originOpportunityId])
}

model ResponsibilityEvent {
  id               String                   @id @default(uuid()) @db.Uuid
  responsibilityId String                   @db.Uuid
  responsibility   Responsibility           @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)
  type             ResponsibilityEventType
  actorClass       ResponsibilityActorClass
  // Immutable provenance reference, deliberately not a live FK. Event actor
  // history must not mutate if a User lifecycle later removes the actor row.
  // The Responsibility itself still owns lifecycle through its principal FK.
  actorUserId      String?                  @db.Uuid
  fromStatus       ResponsibilityStatus?
  toStatus         ResponsibilityStatus?

  // Evidence is reference-only. OR-001 never copies source-domain payloads,
  // raw model reasoning, secrets, or sensitive form values into this ledger.
  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourceState      String?
  evidenceLevel    ResponsibilityEvidenceLevel?

  occurredAt DateTime @default(now())

  @@index([responsibilityId, occurredAt])
  @@index([actorUserId])
  @@index([sourceRecordType, sourceRecordId])
}

// ===========================================================================
// Goal  —  User has many Goals
// ===========================================================================

model Goal {
  id        String     @id @default(uuid()) @db.Uuid
  title     String
  status    GoalStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  userId  String   @db.Uuid
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey Journey?

  @@index([userId])
}

// ===========================================================================
// Journey  —  Goal has one Journey
// ===========================================================================

model Journey {
  id        String        @id @default(uuid()) @db.Uuid
  title     String
  status    JourneyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  goalId     String      @unique @db.Uuid
  goal       Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  milestones Milestone[]
}

// ===========================================================================
// Milestone  —  Journey has many Milestones
// ===========================================================================

model Milestone {
  id        String          @id @default(uuid()) @db.Uuid
  title     String
  status    MilestoneStatus @default(PENDING)
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  journeyId String  @db.Uuid
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([journeyId])
}

