  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum JourneyStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// A current life season, not a demographic classification (WO-030 Founder
// Decision #9). No season is ranked above another; member-selected,
// optional, and changeable at any time.
enum SeasonOfLife {
  STUDENT
  EARLY_CAREER
  YOUNG_FAMILY
  ESTABLISHED_CAREER
  MID_LIFE_TRANSITION
  EMPTY_NEST
  RETIRED
  OTHER
