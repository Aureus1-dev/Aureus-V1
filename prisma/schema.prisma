// ===========================================================================
// Task  —  Milestone has many Tasks
// ===========================================================================

model Task {
  id        String       @id @default(uuid()) @db.Uuid
  title     String
  status    TaskStatus   @default(PENDING)
  priority  TaskPriority @default(MEDIUM)
  position  Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  milestoneId String    @db.Uuid
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}

// ===========================================================================
// Opportunity  —  Core Opportunity Intelligence Engine model
// ===========================================================================

model Opportunity {
  id             String  @id @default(uuid()) @db.Uuid
  sequenceNumber Int     @unique @default(autoincrement())
  opportunityRef String? @unique // AUR-OPP-000001, set after insert

  title            String
  shortDescription String
  fullDescription  String
  category         OpportunityCategory
  tags             String[]            @default([])

  provider          String
  officialSourceUrl String
  applicationUrl    String?
  location          String?
  country           String?
  state             String?

  eligibilityRules String
  benefitType      BenefitType
  benefitAmount    String?
  deadline         DateTime?

  status             OpportunityStatus  @default(DRAFT)
  verificationStatus VerificationStatus @default(DRAFT)
  rejectionReason    String?

  confidenceScore Float @default(0)
  freshnessScore  Float @default(0)

  datePublished    DateTime?
  dateLastVerified DateTime?

  sourceName String
  sourceUrl  String?
  sourceType SourceType @default(ADMIN_ENTRY)

  submittedById   String    @db.Uuid
  createdById     String    @db.Uuid
  lastUpdatedById String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  savedBy                    SavedOpportunity[]
  stewardshipRecommendations StewardshipRecommendation[]
  aiRecommendations          AiRecommendation[]
  harvestProfile             HarvestOfferProfile?
  guidedApplicationSessions  GuidedApplicationSession[]

  @@index([category])
  @@index([verificationStatus])
  @@index([status])
  @@index([benefitType])
  @@index([deadline])
  @@index([createdAt])
}

// ===========================================================================
// Responsible Annual Harvest — governed, member-first promotion execution
// ===========================================================================

model HarvestOfferProfile {
  id                             String             @id @default(uuid()) @db.Uuid
  opportunityId                  String             @unique @db.Uuid
  opportunity                    Opportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  kind                           HarvestOfferKind
  jurisdictionCountry            String             @default("US")
  jurisdictionState              String
  minAge                         Int                @default(21)
  legalStatus                    HarvestLegalStatus @default(REVIEW_REQUIRED)
  licenseAuthority               String
  licenseSourceUrl               String
  termsSourceUrl                 String
  termsVerifiedAt                DateTime
  expiresAt                      DateTime?
  newCustomerOnly                Boolean            @default(true)
  advertisedValueCents           Int
  bankrollRequiredCents          Int                @default(0)
  projectedCashInCents           Int
  projectedCashOutCents          Int
  projectedTaxableWinningsCents  Int                @default(0)
  projectedDeductibleLossesCents Int                @default(0)
  playthroughRequiredCents       Int                @default(0)
  defaultUnitWagerCents          Int?
  estimatedActionsPerMinute      Float?
  estimatedMinutes               Int
  executionInstructions          String[]           @default([])
