  EXPIRED
}

model Pod {
  id               String    @id @default(uuid()) @db.Uuid
  sequenceNumber   Int       @unique @default(autoincrement())
  podRef           String?   @unique
  name             String
  shortDescription String
  fullDescription  String
  type             PodType
  status           PodStatus @default(FORMING)
  capacity         Int       @default(12)
  primaryLanguage  String?
  city          String?
  region        String?
  stateProvince String?
  country       String?
  dormancyThresholdDays Int @default(60)
  parentPodId String? @db.Uuid
  parentPod   Pod?    @relation("PodStewardshipOrigin", fields: [parentPodId], references: [id])
  childPods   Pod[]   @relation("PodStewardshipOrigin")
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  members           PodMembership[]
  events            PodEvent[]
  meetingSchedule   PodMeetingSchedule?
  serviceProjects   PodServiceProject[]
  requests          PodRequest[]
  invitations       PodInvitation[]
  escalations       StewardshipEscalation[]
  aiRecommendations AiRecommendation[]
  conversation      Conversation?

  @@index([type])
  @@index([status])
  @@index([parentPodId])
}

model PodMembership {
  id     String @id @default(uuid()) @db.Uuid
  podId  String @db.Uuid
  pod    Pod    @relation(fields: [podId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   PodMemberRole       @default(MEMBER)
  status PodMembershipStatus @default(PENDING)
  origin PodMembershipOrigin
  invitedById String? @db.Uuid
  joinedAt  DateTime?
  endedAt   DateTime?
  endReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([podId])
  @@index([userId])
  @@index([status])
}

model PodEvent {
  id          String         @id @default(uuid()) @db.Uuid
  podId       String         @db.Uuid
  pod         Pod            @relation(fields: [podId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        PodEventType   @default(MEETING)
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  createdById String         @db.Uuid
  status      PodEventStatus @default(SCHEDULED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  rsvps PodEventRsvp[]

  @@index([podId])
  @@index([startsAt])
}

model PodEventRsvp {
  id       String       @id @default(uuid()) @db.Uuid
  eventId  String       @db.Uuid
  event    PodEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId   String       @db.Uuid
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  response RsvpResponse @default(MAYBE)
  attended Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([userId])
}

model PodMeetingSchedule {
  id              String         @id @default(uuid()) @db.Uuid
  podId           String         @unique @db.Uuid
  pod             Pod            @relation(fields: [podId], references: [id], onDelete: Cascade)
  cadence         MeetingCadence @default(WEEKLY)
  dayOfWeek       Int?
  timeOfDay       String?
  location        String?
  durationMinutes Int?
  createdById     String         @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model PodServiceProject {
  id           String               @id @default(uuid()) @db.Uuid
  podId        String               @db.Uuid
  pod          Pod                  @relation(fields: [podId], references: [id], onDelete: Cascade)
  title        String
  description  String
  status       ServiceProjectStatus @default(PROPOSED)
  proposedById String               @db.Uuid
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([podId])
  @@index([status])
}

model PodRequest {
  id     String         @id @default(uuid()) @db.Uuid
  userId String         @db.Uuid
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   PodRequestType
  podId String? @db.Uuid
  pod   Pod?    @relation(fields: [podId], references: [id], onDelete: Cascade)
  proposedPodName        String?
  proposedPodDescription String?
  reason                 String?
  status      PodRequestStatus @default(PENDING)
  decidedById String?          @db.Uuid
  decidedAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([podId])
  @@index([status])
}

model PodInvitation {
  id            String              @id @default(uuid()) @db.Uuid
  podId         String              @db.Uuid
  pod           Pod                 @relation(fields: [podId], references: [id], onDelete: Cascade)
  invitedUserId String              @db.Uuid
  invitedUser   User                @relation("PodInvitationInvitee", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedById   String              @db.Uuid
  message       String?
  status        PodInvitationStatus @default(PENDING)
  respondedAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([podId])
  @@index([invitedUserId])
  @@index([status])
}

// ===========================================================================
// Connected Experiences
// ===========================================================================

enum ConnectedProviderType {
  GMAIL
  GOOGLE_CALENDAR
  OUTLOOK_MAIL
  OUTLOOK_CALENDAR
  BANKING
  PAYROLL
  INVESTMENT_ACCOUNTS
  GOVERNMENT_BENEFITS
  TAX_RECORDS
}

enum ConnectedAccountStatus {
  CONNECTED
  REVOKED
  ERROR
}

enum DocumentCategory {
  IDENTIFICATION
  LEASE
  FINANCIAL
  EMPLOYMENT
  EDUCATION
  MEDICAL
  LEGAL
  OTHER
}

enum StewardActivityEventType {
  CONNECTION_REQUESTED
  CONNECTION_ESTABLISHED
  CONNECTION_REVOKED
  DOCUMENT_UPLOADED
  DOCUMENT_SUMMARIZED
  DOCUMENT_DELETED
}

enum StewardActivityActor {
  MEMBER
  AI_STEWARD
  SYSTEM
}

model ConnectedAccount {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerType       ConnectedProviderType
  status             ConnectedAccountStatus @default(CONNECTED)
  grantedScopes      String[]
  externalAccountRef String?
  connectedAt DateTime  @default(now())
  revokedAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  activity StewardActivityLog[]

  @@unique([userId, providerType])
  @@index([userId])
}

model Document {
  id             String  @id @default(uuid()) @db.Uuid
  sequenceNumber Int     @unique @default(autoincrement())
  documentRef    String? @unique
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  storageRef       String
  category         DocumentCategory @default(OTHER)
  extractedText        String?
  aiSummary            String?
  aiSummaryGeneratedAt DateTime?
  uploadedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  activity StewardActivityLog[]

  @@index([userId])
  @@index([category])
}

model StewardActivityLog {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType   StewardActivityEventType
  actor       StewardActivityActor
  description String
  connectedAccountId String?           @db.Uuid
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  documentId         String?           @db.Uuid
  document           Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  occurredAt DateTime @default(now())

  @@index([userId])
  @@index([occurredAt])
}

// ===========================================================================
// Launch City Sheet
// ===========================================================================

enum CitySheetCategory {
  CRISIS_LINE
  ASSISTANCE_PROGRAM
  LEGAL_AID
  FOOD_RESOURCE
  HOUSING_UTILITIES
  EMPLOYMENT_JOB_SEARCH
  TRANSPORTATION
  BENEFITS_APPLICATION_SUPPORT
  MAIL_CORRESPONDENCE_SUPPORT
  HEALTHCARE
  OTHER
}

enum LaunchAreaScope {
  CORE_LAUNCH_COUNTY
  GREATER_PHILADELPHIA_SUPPLEMENTAL
}

enum CitySheetVerificationStatus {
  UNVERIFIED
  VERIFIED
  NEEDS_REVIEW
  REJECTED
}

enum CitySheetEntryStatus {
  ACTIVE
  INACTIVE
}

enum CitySheetVerificationEventType {
  VERIFIED
  REJECTED
  FLAGGED_FOR_REVIEW
}

enum CitySheetVerificationConfidence {
  HIGH
  MEDIUM
  LOW
}

model CitySheetEntry {
  id             String  @id @default(uuid()) @db.Uuid
  sequenceNumber Int     @unique @default(autoincrement())
  citySheetRef   String? @unique
  organizationName String
  category         CitySheetCategory
  description      String
  address     String?
  serviceArea String
  launchScope LaunchAreaScope @default(CORE_LAUNCH_COUNTY)
  phone   String?
  website String?
  hours   String
  eligibilityRequirements String?
  languagesSupported      String[] @default([])
  accessibilityNotes      String?
  cost                    String?
  requiredDocuments       String[] @default([])
  referralRequired   Boolean @default(false)
  isEmergencyService Boolean @default(false)
  isTestFixture Boolean @default(false)
  verificationStatus     CitySheetVerificationStatus      @default(UNVERIFIED)
  verificationConfidence CitySheetVerificationConfidence?
  lastVerifiedAt         DateTime?
  verifiedById           String?                          @db.Uuid
  verificationNotes      String?
  rejectionReason        String?
  nextReviewDueAt        DateTime?
  sourceNotes String?
  status CitySheetEntryStatus @default(ACTIVE)
  createdById String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  verificationEvents CitySheetVerificationEvent[]
  resourceOffers     ResourceOffer[]

  @@index([category])
  @@index([launchScope])
  @@index([verificationStatus])
  @@index([status])
  @@index([createdById])
}

model CitySheetChecklistItem {
  id        String             @id @default(uuid()) @db.Uuid
  category  CitySheetCategory?
  label     String
  sortOrder Int                @default(0)
  isActive  Boolean            @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([sortOrder])
}

model CitySheetVerificationEvent {
  id               String         @id @default(uuid()) @db.Uuid
  citySheetEntryId String         @db.Uuid
  citySheetEntry   CitySheetEntry @relation(fields: [citySheetEntryId], references: [id], onDelete: Cascade)
  eventType          CitySheetVerificationEventType
  previousStatus     CitySheetVerificationStatus
  newStatus          CitySheetVerificationStatus
  confidence         CitySheetVerificationConfidence?
  notes              String?
  checklistResponses Json?
  performedById String   @db.Uuid
  performedAt   DateTime @default(now())

  @@index([citySheetEntryId])
  @@index([performedById])
  @@index([performedAt])
  @@index([eventType])
}

model StatedNeed {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String         @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content        String
  createdAt DateTime @default(now())
  resourceOffers  ResourceOffer[]
  needEscalations NeedEscalation[]
  unresolvedNeed  UnresolvedNeed?

  @@index([userId])
  @@index([conversationId])
}

enum ResourceOfferResponse {
  PENDING
  ACCEPTED
  DECLINED
}

model ResourceOffer {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  statedNeedId     String         @db.Uuid
  statedNeed       StatedNeed     @relation(fields: [statedNeedId], references: [id], onDelete: Cascade)
  citySheetEntryId String         @db.Uuid
  citySheetEntry   CitySheetEntry @relation(fields: [citySheetEntryId], references: [id], onDelete: Cascade)
  response    ResourceOfferResponse @default(PENDING)
  offeredAt   DateTime              @default(now())
  respondedAt DateTime?

  @@index([userId])
  @@index([statedNeedId])
  @@index([citySheetEntryId])
}

enum NeedEscalationStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

model NeedEscalation {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  statedNeedId String     @db.Uuid
  statedNeed   StatedNeed @relation(fields: [statedNeedId], references: [id], onDelete: Cascade)
  reason           String?
  status           NeedEscalationStatus @default(PENDING)
  acknowledgedById String?              @db.Uuid
  acknowledgedAt   DateTime?
  resolvedById     String?              @db.Uuid
  resolutionNotes  String?
  resolvedAt       DateTime?
  createdAt        DateTime             @default(now())

  @@index([userId])
  @@index([statedNeedId])
  @@index([status])
}

model PublishedOnCallHours {
  id               String   @id @default("singleton")
  hoursDescription String?
  updatedById      String?  @db.Uuid
  updatedAt        DateTime @updatedAt
}

model UnresolvedNeed {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  statedNeedId String     @unique @db.Uuid
  statedNeed   StatedNeed @relation(fields: [statedNeedId], references: [id], onDelete: Cascade)
  reason    String
  message   String
  createdAt DateTime @default(now())

  @@index([userId])
}
