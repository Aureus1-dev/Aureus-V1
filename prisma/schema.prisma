// ===========================================================================
// Communication System Enums (PA-015)
// ===========================================================================

enum NotificationCategory {
  ACCOUNT
  STEWARDSHIP
  JOURNEY
  OPPORTUNITY
  RESOURCE
  ORGANIZATION
  ANNOUNCEMENT
  MESSAGE
  SYSTEM
  ACADEMY
  POD
  AI_GUIDANCE
  KNOWLEDGE
}

enum DeliveryChannel {
  IN_APP
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum AnnouncementScope {
  PLATFORM
  ORGANIZATION
  ROLE
  STEWARD_MEMBERS
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum ConversationType {
  STEWARDSHIP
  ORGANIZATION
  POD
}

enum MessageStatus {
  SENT
  DELIVERED
  FAILED
}

model Notification {
  id          String               @id @default(uuid()) @db.Uuid
  recipientId String               @db.Uuid
  recipient   User                 @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  category    NotificationCategory
  type        String
  title       String
  body        String
  data        Json?
  actorId     String?              @db.Uuid
  dedupeKey   String?
  readAt      DateTime?
  archivedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())

  deliveries NotificationDelivery[]

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([category])
}

model NotificationDelivery {
  id             String          @id @default(uuid()) @db.Uuid
  notificationId String          @db.Uuid
  notification   Notification    @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        DeliveryChannel
  status         DeliveryStatus  @default(PENDING)
  attempts       Int             @default(0)
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  failureReason  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([notificationId, channel])
  @@index([status])
}

model NotificationPreference {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @db.Uuid
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        NotificationCategory
  inAppEnabled    Boolean              @default(true)
  emailEnabled    Boolean              @default(true)
  digestEnabled   Boolean              @default(false)
  quietHoursStart Int?
  quietHoursEnd   Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([userId, category])
}

model Announcement {
  id             String             @id @default(uuid()) @db.Uuid
  title          String
  body           String
  scope          AnnouncementScope
  organizationId String?            @db.Uuid
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetRole     UserRole?
  stewardId      String?            @db.Uuid
  steward        User?              @relation("AnnouncementSteward", fields: [stewardId], references: [id], onDelete: Cascade)
  status         AnnouncementStatus @default(DRAFT)
  isCritical     Boolean            @default(false)
  scheduledFor   DateTime?
  publishedAt    DateTime?
  expiresAt      DateTime?
  archivedAt     DateTime?
  authorId       String             @db.Uuid
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([scope])
  @@index([status])
  @@index([organizationId])
}

model Conversation {
  id             String                   @id @default(uuid()) @db.Uuid
  type           ConversationType
  relationshipId String?                  @unique @db.Uuid
  relationship   StewardshipRelationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  organizationId String?                  @db.Uuid
  organization   Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  podId          String?                  @unique @db.Uuid
  pod            Pod?                     @relation(fields: [podId], references: [id], onDelete: Cascade)
  lastMessageAt  DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([organizationId])
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String        @db.Uuid
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?
  deletedById    String?       @db.Uuid

  reports MessageReport[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageReport {
  id             String              @id @default(uuid()) @db.Uuid
  messageId      String              @db.Uuid
  message        Message             @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversationId String              @db.Uuid
  reporterId     String              @db.Uuid
  reason         String
  status         MessageReportStatus @default(OPEN)
  resolvedById   String?             @db.Uuid
  resolvedAt     DateTime?
  createdAt      DateTime            @default(now())

  @@index([conversationId, status])
  @@index([status])
}

enum MessageReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ===========================================================================
// Knowledge System Enums (PA-013)
// ===========================================================================

enum KnowledgeCategory {
  ARTICLE
  GUIDE
  POLICY
  BEST_PRACTICE
  RESEARCH_SUMMARY
  FAQ
  TRAINING_MATERIAL
  INSTITUTIONAL_DOCUMENTATION
  REFERENCE_RESOURCE
}

enum KnowledgeArticleStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model KnowledgeArticle {
  id             String  @id @default(uuid()) @db.Uuid
  sequenceNumber Int     @unique @default(autoincrement())
  articleRef     String? @unique

  title    String
  summary  String
  content  String
  category KnowledgeCategory
  tags     String[]          @default([])
  sourceUrl String?

  status             KnowledgeArticleStatus @default(DRAFT)
  verificationStatus VerificationStatus     @default(DRAFT)
  rejectionReason    String?
  version Int @default(1)
  datePublished    DateTime?
  dateLastVerified DateTime?
  authorId        String    @db.Uuid
  lastUpdatedById String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  revisions      KnowledgeArticleRevision[]
  relatedLessons Lesson[]

  @@index([category])
  @@index([verificationStatus])
  @@index([status])
  @@index([authorId])
  @@index([createdAt])
}

model KnowledgeArticleRevision {
  id            String            @id @default(uuid()) @db.Uuid
  articleId     String            @db.Uuid
  article       KnowledgeArticle  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  versionNumber Int
  title         String
  summary       String
  content       String
  category      KnowledgeCategory
  editedById    String            @db.Uuid
  createdAt     DateTime          @default(now())

  @@unique([articleId, versionNumber])
  @@index([articleId])
}

// ===========================================================================
// Academy Enums (PA-010)
// ===========================================================================

enum AcademyContentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum LearningDomain {
  PERSONAL_DEVELOPMENT
  FINANCIAL_LITERACY
  CAREER_READINESS
  ENTREPRENEURSHIP
  LEADERSHIP
  TECHNOLOGY_AND_AI
  HEALTH_AND_WELLBEING
  CIVIC_AND_COMMUNITY_ENGAGEMENT
  STEWARDSHIP
  MISSION_SPECIFIC_PROGRAMS
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum MediaType {
  VIDEO
  DOCUMENT
  IMAGE
  AUDIO
  ATTACHMENT
}

model Course {
  id             String  @id @default(uuid()) @db.Uuid
  sequenceNumber Int     @unique @default(autoincrement())
  courseRef      String? @unique

  title                    String
  shortDescription         String
  fullDescription          String
  learningDomain           LearningDomain
  estimatedDurationMinutes Int?

  status             AcademyContentStatus @default(DRAFT)
  verificationStatus VerificationStatus   @default(DRAFT)
  rejectionReason    String?
  version             Int     @default(1)
  grantsCertification Boolean @default(false)
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  authorId        String    @db.Uuid
  lastUpdatedById String    @db.Uuid
  datePublished   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  modules             Module[]
  revisions           CourseRevision[]
  learningPathCourses LearningPathCourse[]
  enrollments         Enrollment[]
  certifications      Certification[]
  media               CourseMedia[]
  aiRecommendations   AiRecommendation[]

  @@index([learningDomain])
  @@index([verificationStatus])
  @@index([status])
  @@index([authorId])
  @@index([organizationId])
  @@index([createdAt])
}

model CourseRevision {
  id               String   @id @default(uuid()) @db.Uuid
  courseId         String   @db.Uuid
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  versionNumber    Int
  title            String
  shortDescription String
  fullDescription  String
  editedById       String   @db.Uuid
  createdAt        DateTime @default(now())

  @@unique([courseId, versionNumber])
  @@index([courseId])
}

model Module {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id                       String @id @default(uuid()) @db.Uuid
  moduleId                 String @db.Uuid
  module                   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title                    String
  content                  String
  position                 Int
  estimatedDurationMinutes Int?
  relatedArticleId String?           @db.Uuid
  relatedArticle   KnowledgeArticle? @relation(fields: [relatedArticleId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  progress LessonProgress[]
  media    CourseMedia[]

  @@index([moduleId])
  @@index([relatedArticleId])
}

model LearningPath {
  id             String  @id @default(uuid()) @db.Uuid
  sequenceNumber Int     @unique @default(autoincrement())
  pathRef        String? @unique
  title            String
  shortDescription String
  fullDescription String
  status             AcademyContentStatus @default(DRAFT)
  verificationStatus VerificationStatus   @default(DRAFT)
  rejectionReason    String?
  authorId        String    @db.Uuid
  lastUpdatedById String    @db.Uuid
  datePublished   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  pathCourses LearningPathCourse[]

  @@index([verificationStatus])
  @@index([status])
  @@index([authorId])
}

model LearningPathCourse {
  id             String       @id @default(uuid()) @db.Uuid
  learningPathId String       @db.Uuid
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  courseId       String       @db.Uuid
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position       Int
  createdAt      DateTime     @default(now())

  @@unique([learningPathId, courseId])
  @@index([learningPathId])
  @@index([courseId])
}

model Enrollment {
  id       String           @id @default(uuid()) @db.Uuid
  userId   String           @db.Uuid
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String           @db.Uuid
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status   EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  lessonProgress LessonProgress[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id           String               @id @default(uuid()) @db.Uuid
  enrollmentId String               @db.Uuid
  enrollment   Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String               @db.Uuid
  lesson       Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status       LessonProgressStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
}

model Certification {
  id             String   @id @default(uuid()) @db.Uuid
  sequenceNumber Int      @unique @default(autoincrement())
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String   @db.Uuid
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certificateRef String?  @unique
  issuedAt       DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
}

model MediaAsset {
  id             String  @id @default(uuid()) @db.Uuid
  sequenceNumber Int     @unique @default(autoincrement())
  mediaRef       String? @unique
  type            MediaType
  title           String
  description     String?
  storageRef      String
  mimeType        String?
  sizeBytes       Int?
  durationSeconds Int?
  uploadedById String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  courseMedia CourseMedia[]

  @@index([type])
  @@index([uploadedById])
}

model CourseMedia {
  id           String     @id @default(uuid()) @db.Uuid
  courseId     String     @db.Uuid
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId     String?    @db.Uuid
  lesson       Lesson?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  mediaAssetId String     @db.Uuid
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([courseId])
  @@index([lessonId])
  @@index([mediaAssetId])
}

// ===========================================================================
// AI Intelligence Engine
// ===========================================================================

enum AiProvider {
  OPENAI
  ANTHROPIC
  STUB
}

enum AiCapability {
  QUESTION_ANSWERING
  RECOMMENDATION
  OPPORTUNITY_EXPLANATION
  RESOURCE_EXPLANATION
  JOURNEY_GUIDANCE
  ACADEMY_GUIDANCE
  KNOWLEDGE_SEARCH
  POD_INSIGHT
  VOICE_CONVERSATION
  DOCUMENT_SUMMARY
  NEXT_BEST_ACTION
  STEWARD_ESCALATION
  PUBLIC_WARD_CONVERSATION
  APPLICATION_GUIDANCE
}

enum AiRequestStatus {
  SUCCESS
  FAILED
  MODERATION_BLOCKED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AiRecommendationStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

model AiConversation {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @db.Uuid
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages                  AiMessage[]
  requests                  AiRequest[]
  voiceSessions             AiVoiceSession[]
  guidedApplicationSessions GuidedApplicationSession[]
  statedNeeds               StatedNeed[]

  @@index([userId])
}

enum GuidedApplicationSessionStatus {
  ACTIVE
  ENDED
}

model GuidedApplicationSession {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String         @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  opportunityId  String         @db.Uuid
  opportunity    Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  responsibilityId String?         @db.Uuid
  responsibility   Responsibility? @relation(fields: [responsibilityId], references: [id], onDelete: SetNull)
  applicationUrl String
  status         GuidedApplicationSessionStatus @default(ACTIVE)
  screenCaptureConsentGrantedAt DateTime?
  screenCaptureConsentRevokedAt DateTime?
  lastFrameAnalyzedAt           DateTime?
  endedAt                       DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([conversationId, status])
  @@index([opportunityId])
  @@index([responsibilityId])
}

model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiMessageRole
  content        String
  createdAt      DateTime       @default(now())
  completionStatus AiMessageCompletionStatus @default(COMPLETE)
  voiceSessionId   String?                   @db.Uuid
  voiceSession     AiVoiceSession?           @relation(fields: [voiceSessionId], references: [id], onDelete: SetNull)
  providerItemId   String?

  @@unique([voiceSessionId, providerItemId])
  @@index([conversationId])
}

enum AiMessageCompletionStatus {
  COMPLETE
  INTERRUPTED
  CANCELLED
}

enum VoiceSessionEndReason {
  MEMBER_ENDED
  TIMEOUT
  DURATION_LIMIT
  ERROR
  RECONNECT_SUPERSEDED
}

model AiVoiceSession {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String         @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider AiProvider @default(OPENAI)
  model    String
  voice    String
  turnDetectionMode   String
  turnDetectionConfig Json
  providerSessionRef String?
  startedAt DateTime               @default(now())
  endedAt   DateTime?
  endReason VoiceSessionEndReason?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages   AiMessage[]
  turnEvents AiTurnEvent[]

  @@index([conversationId])
  @@index([userId])
  @@index([userId, endedAt])
}

enum AiTurnEventType {
  MEMBER_SPEECH_STARTED
  MEMBER_SPEECH_STOPPED
  MEMBER_TURN_FINALIZED
  STEWARD_RESPONSE_STARTED
  STEWARD_RESPONSE_COMPLETED
  STEWARD_RESPONSE_INTERRUPTED
  SILENCE_TIMEOUT
}

model AiTurnEvent {
  id             String         @id @default(uuid()) @db.Uuid
  voiceSessionId String         @db.Uuid
  voiceSession   AiVoiceSession @relation(fields: [voiceSessionId], references: [id], onDelete: Cascade)
  type           AiTurnEventType
  providerItemId String?
  occurredAt     DateTime
  recordedAt     DateTime        @default(now())
  metadata       Json?

  @@unique([voiceSessionId, type, providerItemId])
  @@index([voiceSessionId, occurredAt])
}

model AiRequest {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?         @db.Uuid
  conversation   AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  organizationId     String?           @db.Uuid
  wardConversationId String?           @db.Uuid
  wardConversation   WardConversation? @relation(fields: [organizationId, wardConversationId], references: [organizationId, id], onDelete: Cascade)
  capability       AiCapability
  provider         AiProvider
  model            String
  promptTokens     Int
  completionTokens Int
  costUsd          Float
  latencyMs        Int
  status           AiRequestStatus
  errorMessage     String?
  createdAt DateTime @default(now())
  recommendations AiRecommendation[]

  @@index([userId])
  @@index([organizationId, createdAt])
  @@index([wardConversationId])
  @@index([capability])
  @@index([createdAt])
}

model AiOperationalConfig {
  id                   String   @id @default("singleton")
  emergencyStop        Boolean  @default(false)
  globalDailyBudgetUsd Float    @default(50)
  userDailyBudgetUsd   Float    @default(2)
  updatedById          String?  @db.Uuid
  updatedBy            User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt            DateTime @updatedAt
}

model AiCapabilityBudget {
  id                String       @id @default(uuid()) @db.Uuid
  capability        AiCapability @unique
  dailyBudgetUsd    Float?
  dailyRequestLimit Int?
  updatedById       String?      @db.Uuid
  updatedAt         DateTime     @updatedAt
}

model AiRecommendation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId  String?                  @db.Uuid
  opportunity    Opportunity?             @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  resourceId     String?                  @db.Uuid
  resource       Resource?                @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  courseId       String?                  @db.Uuid
  course         Course?                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  podId          String?                  @db.Uuid
  pod            Pod?                     @relation(fields: [podId], references: [id], onDelete: Cascade)
  relationshipId String?                  @db.Uuid
  relationship   StewardshipRelationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  rationale String
  status    AiRecommendationStatus @default(PENDING)
  decidedAt DateTime?
  aiRequestId String?    @db.Uuid
  aiRequest   AiRequest? @relation(fields: [aiRequestId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([opportunityId])
  @@index([resourceId])
  @@index([relationshipId])
  @@index([courseId])
  @@index([podId])
}

enum AiOrchestrationGoal {
  NEXT_BEST_ACTION
  OPPORTUNITY_SUGGESTION
  RESOURCE_SUGGESTION
  JOURNEY_GUIDANCE
  STEWARD_ESCALATION
  EDUCATIONAL_RECOMMENDATION
  COORDINATED_PLAN
}

enum AiOrchestrationStatus {
  SUCCESS
  PARTIAL
  FAILED
  NO_ACTION
}

model AiOrchestrationRun {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal                AiOrchestrationGoal
  capabilitiesInvoked AiCapability[]
  outcome             String
  status              AiOrchestrationStatus
  latencyMs           Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([goal])
  @@index([createdAt])
}

